# The bot's token (Discord developer portal > your application > Bot). Turn on, in the same page, the
# "Message Content" and "Server Members" privileged intents.
DISCORD_BOT_TOKEN=
DISCORD_BOT_INVIT_URL=

# The Clara server, and one of its client tokens: on the server, CLARA_TOKENS=discord:<token> (and
# CLARA_CLIENT_SURFACES=discord=discord to keep this token to Discord accounts).
CLARA_URL=http://127.0.0.1:8765
CLARA_TOKEN=

# Optional: the clock Clara is told (IANA name); default: the server's
# CLARA_TIMEZONE=Europe/Paris

# Optional: where the log goes (<dir>/logs/clara-discord.log); default: data
# CLARA_DISCORD_DATA_DIR=data
