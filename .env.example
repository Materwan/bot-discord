# Required
DISCORD_BOT_TOKEN=
BOT_OWNER_ID=

# Ollama model and server (defaults: gemma4:31b-cloud, local server)
OLLAMA_MODEL=
OLLAMA_HOST=

# Exchanges (question + answer) kept per channel and re-injected in the prompt (default: 20)
HISTORY_SIZE=

# 0 disables the LLM pass that extracts facts and tone after each answer (default: 1)
AUTO_INSIGHTS=1

# Comma-separated IDs of other bots allowed to talk to Clara
ALLOWED_BOT_IDS=
